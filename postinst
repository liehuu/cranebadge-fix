#!/bin/sh
# 安装后：清掉 Crane 的 BadgeStore 存量缓存。
# 注意：这里 **不再** killall SpringBoard —— 避免安装即重启导致用户不适 / 打断使用。
# 补丁（ CraneBadgeFix.dylib ）需在下次 SpringBoard 启动时加载，
# 其「启动清零模式」会把 Crane 从 plist 恢复的历史角标压成 0 并回写 plist，
# 因此装完补丁请手动重启一次 SpringBoard（设置里重启，或关机重启）才会生效。
rm -f /var/jb/var/mobile/Library/Crane/BadgeStore.plist 2>/dev/null
rm -f /var/mobile/Library/Crane/BadgeStore.plist 2>/dev/null
exit 0
